# Get your FREE Groq API key at: https://console.groq.com
# Sign up → API Keys → Create API Key
# Key starts with: gsk_
GROQ_API_KEY=gsk_your_key_here

# Optional — enables live web search (news/scores/trending) grounding.
# Get a FREE key (1,000 searches/month) at: https://tavily.com
# Without this set, search-gated replies just fall back to the model's own knowledge.
TAVILY_API_KEY=tvly_your_key_here
