# Get your FREE Groq API key at: https://console.groq.com
# Sign up → API Keys → Create API Key
# Key starts with: gsk_
GROQ_API_KEY=gsk_your_key_here

# Optional — enables live web search (news/scores/trending) grounding.
# Get a FREE key (1,000 searches/month) at: https://tavily.com
# Without this set, search-gated replies just fall back to the model's own knowledge.
TAVILY_API_KEY=tvly_your_key_here

# Optional — enables the AI to draft & send emails when you ask it to.
# Get a FREE key (no card needed) at: https://resend.com
# On a free/unverified-domain account you can only send FROM onboarding@resend.dev
# and only TO the email address you signed up with — verify a domain to send to others.
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
